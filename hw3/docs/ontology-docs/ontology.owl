    // Classes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://purl.org/ieee1872-owl/cora-bare#Robot -->


    <owl:Class rdf:about="http://purl.org/ieee1872-owl/cora-bare#Robot">
        <rdfs:label xml:lang="en">Robot (IEEE 1872 CORA)</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/ieee1872-owl/pos#Orientation -->


    <owl:Class rdf:about="http://purl.org/ieee1872-owl/pos#Orientation"/>
    


    <!-- http://purl.org/ieee1872-owl/pos#Pose -->


    <owl:Class rdf:about="http://purl.org/ieee1872-owl/pos#Pose"/>
    


    <!-- http://purl.org/ieee1872-owl/pos#Position -->


    <owl:Class rdf:about="http://purl.org/ieee1872-owl/pos#Position"/>
    


    <!-- http://taica.course/hw3/ontology#FKComputation -->


    <owl:Class rdf:about="http://taica.course/hw3/ontology#FKComputation">
        <rdfs:subClassOf rdf:resource="http://taica.course/hw3/ontology#KinematicComputation"/>
        <rdfs:label xml:lang="en">Forward Kinematics Computation</rdfs:label>
    </owl:Class>
    


    <!-- http://taica.course/hw3/ontology#IKComputation -->


    <owl:Class rdf:about="http://taica.course/hw3/ontology#IKComputation">
        <rdfs:subClassOf rdf:resource="http://taica.course/hw3/ontology#KinematicComputation"/>
        <rdfs:label xml:lang="en">Inverse Kinematics Computation</rdfs:label>
    </owl:Class>
    


    <!-- http://taica.course/hw3/ontology#JointConfiguration -->


    <owl:Class rdf:about="http://taica.course/hw3/ontology#JointConfiguration">
        <rdfs:comment xml:lang="en">A full arm configuration: the aggregation of exactly one soma:JointState per kinematic joint. Each state points back at the joint individual it describes.</rdfs:comment>
        <rdfs:label xml:lang="en">Joint Configuration</rdfs:label>
    </owl:Class>
    


    <!-- http://taica.course/hw3/ontology#KinematicComputation -->


    <owl:Class rdf:about="http://taica.course/hw3/ontology#KinematicComputation">
        <rdfs:label xml:lang="en">Kinematic Computation</rdfs:label>
    </owl:Class>
    


    <!-- http://taica.course/hw3/ontology#QuaternionOrientation -->


    <owl:Class rdf:about="http://taica.course/hw3/ontology#QuaternionOrientation">
        <rdfs:subClassOf rdf:resource="http://purl.org/ieee1872-owl/pos#Orientation"/>
        <rdfs:label xml:lang="en">Quaternion Orientation (x, y, z, w)</rdfs:label>
    </owl:Class>
    


    <!-- http://www.ease-crc.org/ont/SOMA.owl#Joint -->


    <owl:Class rdf:about="http://www.ease-crc.org/ont/SOMA.owl#Joint">
        <rdfs:label xml:lang="en">Joint (SOMA)</rdfs:label>
    </owl:Class>
    


    <!-- http://www.ease-crc.org/ont/SOMA.owl#JointState -->


    <owl:Class rdf:about="http://www.ease-crc.org/ont/SOMA.owl#JointState"/>
    


    <!-- http://www.ease-crc.org/ont/SOMA.owl#RevoluteJoint -->


    <owl:Class rdf:about="http://www.ease-crc.org/ont/SOMA.owl#RevoluteJoint">
        <rdfs:subClassOf rdf:resource="http://www.ease-crc.org/ont/SOMA.owl#Joint"/>
        <rdfs:label xml:lang="en">Revolute Joint (SOMA)</rdfs:label>
    </owl:Class>
    


    <!-- http://www.ease-crc.org/ont/SOMA.owl#6DPose -->


    <owl:Class rdf:about="http://www.ease-crc.org/ont/SOMA.owl#6DPose">
        <rdfs:subClassOf rdf:resource="http://purl.org/ieee1872-owl/pos#Pose"/>
        <rdfs:label xml:lang="en">6D Pose (SOMA)</rdfs:label>
    </owl:Class>
</rdf:RDF>



