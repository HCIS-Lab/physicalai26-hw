@prefix sh:   <http://www.w3.org/ns/shacl#> .
@prefix hw3:  <http://taica.course/hw3/ontology#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix soma: <http://www.ease-crc.org/ont/SOMA.owl#> .

# =============================================================================
# Task 4 / SHACL + SPARQL — find the KEY DIFFERENCES between the TA's FAULTY FK/IK
# execution (TA.ttl) and YOURS (output/Student.ttl)
#
# run_task4.py loads both executions into ONE graph and validates it with this file
# using pySHACL. Then it runs your SPARQL queries on data + validation report.
# You are not told what is wrong in the TA's code: the shapes and queries below
# are how you FIND it, and your report must state what you found.
#
# FK part. Both executions record the FK chain  A_k = A_(k-1) @ T_k  as
# hw3:FKStep nodes (see ontology/hw3-ontology.ttl):
#
#   step  hw3:isStepOfComputation  <FK computation>   (hw3:caseIndex 0..2, hw3:producedBy)
#         hw3:stepIndex            k  (0 = base, 1..6 = joints)
#         hw3:hasLocalTransform    T_k          (hw3:HomogeneousTransform)
#         hw3:hasCumulativeTransform A_k        (entries hw3:m00 .. hw3:m23)
#
# IK part. Every IK execution is an hw3:IKComputation (hw3:solvesForTarget = the shared
# hw3:target_near / _mid / _far, hw3:hasIKStatus, hw3:hasResidual, hw3:hasMaxIterations,
# hw3:hasJointConfiguration -> six soma:JointState).
#
# The TA's computations have hw3:producedBy "TA". Your shapes must flag ONLY the TA's
# nodes. The scorer identifies flags by the prefix of sh:message, so use exactly the
# prefixes below. Use a tolerance of 0.001 on matrix entries.
# =============================================================================

hw3:Task4Prefixes sh:declare
    [ sh:prefix "hw3" ;  sh:namespace "http://taica.course/hw3/ontology#"^^xsd:anyURI ] ,
    [ sh:prefix "soma" ; sh:namespace "http://www.ease-crc.org/ont/SOMA.owl#"^^xsd:anyURI ] .

# ---- Worked example 1 (done): a plain SHACL-core check ----------------------
# The TA's FK is far from the ground truth -> FK_INACCURATE.
hw3:FKAccuracyShape a sh:NodeShape ;
    sh:targetClass hw3:FKComputation ;
    sh:property [
        sh:path hw3:hasPoseError ;
        sh:maxInclusive "0.005"^^xsd:double ;
        sh:message "FK_INACCURATE: position error above the 0.005 m course threshold" ;
    ] .

# ---- Worked example 2 (done): a cross-graph SHACL-SPARQL check --------------
# Joins a TA joint with YOUR joint of the same hw3:jointIndex and compares their
# D-H parameters. Result: no DH_MISMATCH, so the D-H table is NOT the problem.
hw3:DHMismatchShape a sh:NodeShape ;
    sh:targetClass soma:RevoluteJoint ;
    sh:sparql [
        sh:message "DH_MISMATCH: D-H parameter of the TA robot differs from yours" ;
        sh:prefixes hw3:Task4Prefixes ;
        sh:select """
            SELECT $this
            WHERE {
                $this hw3:jointIndex ?i ;
                      hw3:dh_a ?ta ; hw3:dh_d ?td ; hw3:dh_alpha ?tal .
                ?taRobot hw3:hasJoint $this ;
                         hw3:producedBy "TA" .
                ?other hw3:jointIndex ?i ;
                       hw3:dh_a ?sa ; hw3:dh_d ?sd ; hw3:dh_alpha ?sal .
                ?stuRobot hw3:hasJoint ?other ;
                          hw3:producedBy ?who .
                FILTER (?who != "TA")
                FILTER (ABS(?ta - ?sa) > 0.000001 ||
                        ABS(?td - ?sd) > 0.000001 ||
                        ABS(?tal - ?sal) > 0.000001)
            }
        """ ;
    ] .

